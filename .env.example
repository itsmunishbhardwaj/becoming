# Balboa Breakdown LLM proxy — leave unset to use the scripted fallback wizard.
# Any OpenAI-compatible endpoint works. Defaults target OpenRouter.
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=ds/deepseek-v4-flash
LLM_API_KEY=sk-your-key-here

# Vault location — persistent data lives here. Point it at iCloud Drive
# for auto-sync + auto-backup. Absolute path required.
# Example: /Users/YOU/Library/Mobile Documents/com~apple~CloudDocs/Becoming/vault
# Falls back to ./vault (in-repo) if unset — NOT recommended.
VAULT_ROOT=
